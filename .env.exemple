# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection — currently unused by the Next.js app now that the
# TBA client lives in-process (src/lib/api/tba); kept here for the
# in-house scouting CRUD/persistence work that hasn't landed yet.
DB_NAME=your-db
DB_USER=api-user
DB_PASSWORD=your_password_here
DB_HOST=your_database-host
DB_PORT=db_port

# The Blue Alliance API v3 — get a read key at
# https://www.thebluealliance.com/account. Read server-side only via
# src/lib/config/config.ts; never exposed to the client bundle.
TBA_KEY=your_thebluealliance_api_key_here
TBA_BASE_URL=https://www.thebluealliance.com/api/v3